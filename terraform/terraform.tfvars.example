# Copy this file to terraform.tfvars and fill in your values.
# Never commit terraform.tfvars — it is gitignored.

# Your domain (must have a Route53 hosted zone)
domain         = "example.com"
hosted_zone_id = "ZXXXXXXXXXXXXXXXXX"

# S3 bucket for game assets — must be globally unique
s3_bucket = "foundry-vtt-yourname-ap-southeast-2"

# VPC — the default VPC works fine
vpc_id = "vpc-xxxxxxxxxxxxxxxxx"

# One subnet per AZ (get these from the AWS console or `aws ec2 describe-subnets`)
subnet_ids = [
  "subnet-xxxxxxxxxxxxxxxxx",
  "subnet-xxxxxxxxxxxxxxxxx",
  "subnet-xxxxxxxxxxxxxxxxx",
]

# CIDR blocks of the subnets above — added to S3 policy so ECS tasks can reach assets
vpc_subnet_cidrs = [
  "10.0.0.0/24",
  "10.0.1.0/24",
  "10.0.2.0/24",
]

# ACM certificate for api.example.com — must be in the same region as your deployment
# Create with: aws acm request-certificate --domain-name api.example.com --validation-method DNS
api_cert_arn = "arn:aws:acm:ap-southeast-2:123456789012:certificate/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# The world folder name under Data/worlds/ to auto-launch on startup
foundry_world = "my-campaign"

# Hostname written into options.json — Foundry binds the license to this value
container_hostname = "foundry.example.com"

# Timezone for the container
timezone = "America/New_York"

# Optional overrides
# fargate_cpu    = 1024
# fargate_memory = 2048
# foundry_image  = "ghcr.io/felddy/foundryvtt:14"
# auto_stop_schedule = "cron(0 15 * * ? *)"
